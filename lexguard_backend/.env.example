ENVIRONMENT=development
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=
# Must support strict JSON-schema structured output.
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6
# Required in production; set the same random secret in the frontend server.
ANALYSIS_API_KEY=
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:3000
MAX_CONCURRENT_ANALYSES=2
ANALYSES_PER_HOUR=10
GLOBAL_ANALYSES_PER_HOUR=60
HOST=127.0.0.1
PORT=8000
